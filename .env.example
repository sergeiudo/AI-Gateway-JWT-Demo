# Copy to .env and fill in. Never commit the real .env.

# --- Microsoft Entra ID (app registration) ---
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_client_secret_value
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Must match the redirect URI registered on the app, trailing slash included
REDIRECT_URI=http://localhost:8501/

# --- AI gateway ---
PORTKEY_ORG_ID=00000000-0000-0000-0000-000000000000
PORTKEY_WORKSPACE_SLUG=ws-your-workspace
# Slug of a saved provider integration, e.g. @your-bedrock
PORTKEY_PROVIDER=@your-bedrock
PORTKEY_BASE_URL=https://aigw.portkey.ai/v1
PORTKEY_DEFAULT_CONFIG_ID=pc-your-config-id

# --- Optional: one address exempt from model routing ---
# Leave blank and everyone is routed by role.
POLICY_EXEMPT_EMAIL=

# --- Signing keys (created by generate_keys.py) ---
PRIVATE_KEY_PATH=private_key.pem
JWKS_PATH=jwks.json
